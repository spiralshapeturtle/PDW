/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

PDWMENU MENU
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "&Open/Close Logfile...\tAlt+L", IDM_LOGFILE
        MENUITEM SEPARATOR
        MENUITEM "&Exit\tAlt+F4",               IDM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy Selection\tCtrl+C",     IDM_COPY_SELECTION
        MENUITEM "Copy &Monitor Window\tCtrl+U", IDM_COPY_UPPER
        MENUITEM "Copy &Filter Window\tCtrl+L", IDM_COPY_LOWER
        MENUITEM "&Save Clipboard...",          IDM_COPY_SAVE
        MENUITEM "&Print Clipboard...\tCtrl+P", IDM_COPY_PRINT
    END
    POPUP "&Interface"
    BEGIN
        MENUITEM "&Setup...\tCtrl-S",           IDM_INTERFACE
        MENUITEM "&Volume...\tAlt-V",           IDM_VOLUME
    END
    POPUP "Options"
    BEGIN
        MENUITEM "&Options...\tCtrl-O",         IDM_OPTIONS
        MENUITEM "&General...\tCtrl-G",         IDM_GENERAL
        MENUITEM "&SMTP/Email...\tCtrl-M",      IDM_MAIL
        MENUITEM "&Webhook...\tCtrl-W",         IDM_WEBHOOK
        MENUITEM "MQ&TT...\tCtrl-Q",            IDM_MQTT
        MENUITEM "Te&legram...",                IDM_TELEGRAM
        MENUITEM "&Pushover...",                IDM_PUSHOVER
        MENUITEM "Telnet &Server...\tCtrl-N",   IDM_TELNETSERVER
        MENUITEM "RX &Quality Alert...",        IDM_RXQUAL_ALERT
        MENUITEM "&MySQL...",                   IDM_MYSQL
        MENUITEM "SQ&Lite...",                  IDM_SQLITE
        MENUITEM SEPARATOR
        MENUITEM "Live &Debug Log (FLEX)",      IDM_DEBUGLOG
    END
    POPUP "Filters"
    BEGIN
        MENUITEM "&Filter List...\tCtrl-F",     IDM_FILTERS
        MENUITEM "&Filter Options...",          IDM_FILTEROPTIONS
        MENUITEM "&Reload Filters",             IDM_RELOAD
        MENUITEM "&Reset &ALL Hitcounters...",  IDM_RESET_HITCOUNTERS
        MENUITEM SEPARATOR
        MENUITEM "Filter File Output",          IDM_FILTERFILE_EN
        MENUITEM "Filter Command File",         IDM_FILTERCOMMANDFILE
    END
    POPUP "&Display"
    BEGIN
        MENUITEM "C&lear Screen...\tCtrl-D",    IDM_CLEARDISPLAY
        MENUITEM "&Colors...",                  IDM_COLOR
        MENUITEM "&Font...\tAlt-F",             IDM_FONT
        MENUITEM "Screen &Options...",          IDM_SCREENOPTIONS
        MENUITEM "&Scrollback...",              IDM_SCROLLBACK
        MENUITEM "System&tray...\tCtrl-T",      IDM_SYSTEMTRAY
    END
    POPUP "&Monitor"
    BEGIN
        MENUITEM "&POCSAG/FLEX",                IDM_POCSAGFLEX
        MENUITEM "&ACARS",                      IDM_ACARS
        MENUITEM "&MOBITEX",                    IDM_MOBITEX
        MENUITEM "&ERMES",                      IDM_ERMES
        MENUITEM SEPARATOR
        MENUITEM "&Statistics...\tAlt-S",       IDM_MONSTAT
    END
    POPUP "&Character Set"
    BEGIN
        MENUITEM "&Default",                    IDM_ENGLISH
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help (opens PDW.pdf)\tF1",   IDM_HELP
        MENUITEM SEPARATOR
        MENUITEM "&Debug Information...\tF12",  IDM_DEBUG
        MENUITEM SEPARATOR
        MENUITEM "&About...",                   IDM_ABOUT
    END
END


