<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1"
          manifestVersion="1.0"
          xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">

  <assemblyIdentity type="win32" name="PDW" version="1.0.0.0"/>

  <!-- FIX [ToolbarHiResIcons]: Common Controls v6. Required for alpha-blended 32bpp
       toolbar imagelists (the new high-res icons); also gives all dialogs the modern
       themed look instead of the classic Windows 2000 style. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32"
                        name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0"
                        processorArchitecture="*"
                        publicKeyToken="6595b64144ccf1df"
                        language="*"/>
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- FIX [DpiScale]: System DPI Aware. g_dpi wordt eenmalig in WM_CREATE bepaald;
       alle layout/pixels lopen via Scale() in initapp.h. (true = system aware,
       true/pm = per-monitor; bewust system gekozen als veilige eerste stap.) -->
  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </asmv3:windowsSettings>
  </asmv3:application>

</assembly>
